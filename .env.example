# Every environment variable this project reads, with empty values.
#
# This file is documentation and IS committed. Real values go in Vercel
# (Project > Settings > Environment Variables) and, for local work with
# `vercel dev`, in a .env file next to this one. .env is gitignored and must
# never be committed.
#
# See README.md for what each one does.

# ---- Stripe (server only, read by api/*) ---------------------------------
# Secret key, sk_test_... or sk_live_... Never give it a VITE_ prefix.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint, whsec_... Test and live mode
# endpoints each have their own.
STRIPE_WEBHOOK_SECRET=

# ---- Email (server only, read by api/stripe-webhook.js) ------------------
RESEND_API_KEY=
# Where the work order lands, and the Reply-To on the customer confirmation.
# If this is empty NEITHER email is sent.
ORDER_NOTIFICATION_EMAIL=

# ---- Site origin (server only, optional) ---------------------------------
# e.g. https://tippincowgirl.com . Unset derives it from the request.
PUBLIC_BASE_URL=

# ---- Booking form (read at BUILD time, baked into the client bundle) -----
# The Google Apps Script web app URL ending in /exec. Not a secret. Changing
# it needs a redeploy, not just a restart.
VITE_BOOKING_ENDPOINT=

# ---- Giveaway page, /giveaway (BUILD time, like the one above) ------------
# A DIFFERENT Apps Script, writing to a different Sheet. Never the booking
# URL: the page refuses to send if the two are the same.
VITE_GIVEAWAY_ENDPOINT=

# ---- Staff portal, /admin (Supabase) -------------------------------------
# See docs/portal-setup.md. Supabase > Project Settings > API.
#
# Server only, read by api/stripe-webhook.js to store every paid order.
# The service role key bypasses all security rules: it must NEVER get a
# VITE_ prefix and never appear in client code. Without these two, orders
# are still emailed but not stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Read at BUILD time and baked into the client bundle, for the /admin
# login. Both are public by design (the anon key only does what the Row
# Level Security in supabase/schema.sql allows). Same URL as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
