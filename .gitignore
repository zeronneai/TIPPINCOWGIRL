node_modules
dist
*.local
.DS_Store

# Environment files carry live keys. Never commit them. .env.example is the
# one exception: it lists the variable names with empty values, as docs.
.env
.env.*
!.env.example

# Customer data (CSV exports of the booking Sheet, and the like). Never commit.
data/

# Demo video (video/): its own node_modules, the app build it screenshots,
# downloaded fonts, an optional music track and the rendered MP4.
video/node_modules/
video/out/
video/.app-build/
video/public/fonts/
video/public/music.mp3
# hat art copied or downloaded for the ad by video/scripts/prepare-ad.mjs,
# and its optional music track
video/public/ad/
video/public/engraving/
video/public/ad-music.mp3
# the guide ad's optional music track
video/public/guide-music.mp3
